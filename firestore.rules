rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify if the requester is the authorized administrator
    function isAuthorizedAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'ssfoods.erode@gmail.com';
    }

    // Public website content - Public Read, Admin Write
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Customer Enquiries - Public can submit, only Admin can read/manage
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAuthorizedAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
